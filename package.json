{
  "name": "comedor-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web-admin\"",
    "dev:cliente": "npm run dev --workspace=apps/web-cliente",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web-admin && npm run build --workspace=apps/web-cliente",
    "lint": "npm run lint --workspace=apps/web-admin",
    "typecheck": "tsc --noEmit --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=packages/database",
    "db:push": "npm run db:push --workspace=packages/database",
    "db:generate": "npm run db:generate --workspace=packages/database",
    "db:seed": "npm run db:seed --workspace=packages/database",
    "pg:start": "powershell -ExecutionPolicy Bypass -File scripts/start-portable-postgres.ps1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
