JWT_REFRESH_SECRET=CAMBIAR_EN_PRODUCCION_diferente_al_anterior
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# Seguridad
# ============================================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_ATTEMPTS=5
STOCK_PERMITIR_NEGATIVO=false

# ============================================================
# Admin inicial (seed)
# ============================================================
ADMIN_EMAIL=admin@comedor.local
ADMIN_PASSWORD=Admin123456!

# ============================================================
# SIFEN / Facturación Paraguay
