# ============================================
# COMEDOR SYSTEM - Environment Variables
# Copy to apps/api/.env for local API (npm run dev loads cwd apps/api).
# ============================================

# === DATABASE ===
# Docker Compose usa el puerto 5432. Si el servidor local rechaza 5432 (permisos / Hyper-V), Postgres portable suele ir en 55432.
DATABASE_URL="postgresql://comedor:comedor123@localhost:5432/comedor"

# === JWT ===
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
# JWT expires in 8 hours, refresh in 7 days

# === API SERVER ===
PORT=3001
NODE_ENV=development

# === CORS ===
CORS_ORIGIN=http://localhost:3000

# === REDIS (optional, for future use) ===
REDIS_URL="redis://localhost:6379"

# === FRONTEND ===
VITE_API_URL=http://localhost:3001/api

# === EMAIL (optional, for notifications) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="Sistema Comedor <noreply@comedor.com>"

# === WHATSAPP (optional, for notifications) ===
# WHATSAPP_API_URL=https://api.whatsapp.com/...
# WHATSAPP_API_KEY=your-key

# === PARAGUAY SPECIFIC ===
# Timezone for date handling
TZ=America/Asuncion

# === DEFAULTS ===
# Default admin: admin@comedor.com / admin123
# Default sucursal: Sucursal Principal
